@misc{nayak_robustbf_2021,
	title = {{RobustBF}: A High Accuracy and Memory Efficient 2D Bloom Filter},
	url = {http://arxiv.org/abs/2106.04365},
	doi = {10.48550/arXiv.2106.04365},
	shorttitle = {{RobustBF}},
	abstract = {Bloom Filter is an important probabilistic data structure to reduce memory consumption for membership filters. It is applied in diverse domains such as Computer Networking, Network Security and Privacy, {IoT}, Edge Computing, Cloud Computing, Big Data, and Biometrics. But Bloom Filter has an issue of the false positive probability. To address this issue, we propose a novel robust Bloom Filter, {robustBF} for short. {robustBF} is a 2D Bloom Filter, capable of filtering millions of data with high accuracy without compromising the performance. Our proposed system is presented in two-fold. Firstly, we modify the murmur hash function, and test all modified hash functions for improvements and select the best-modified hash function experimentally. Secondly, we embed the modified hash functions in 2D Bloom Filter. Our experimental results show that {robustBF} is better than standard Bloom Filter and counting Bloom Filter in every aspect. {robustBF} exhibits nearly zero false positive probability with more than \$10{\textbackslash}times\$ and \$44{\textbackslash}times\$ lower memory consumption than standard Bloom filter and counting Bloom Filter, respectively.},
	number = {{arXiv}:2106.04365},
	publisher = {{arXiv}},
	author = {Nayak, Sabuzima and Patgiri, Ripon},
	urldate = {2022-11-25},
	date = {2021-09-08},
	eprinttype = {arxiv},
	eprint = {2106.04365 [cs]},
	keywords = {Computer Science - Data Structures and Algorithms, 41-{XX}, 68Mxx, 68Wxx, E.1, E.2, H.2, H.3},
	file = {arXiv Fulltext PDF:/Users/mehranghamaty/Zotero/storage/C78DZJ8A/Nayak and Patgiri - 2021 - RobustBF A High Accuracy and Memory Efficient 2D .pdf:application/pdf;arXiv.org Snapshot:/Users/mehranghamaty/Zotero/storage/YTVGTS64/2106.html:text/html},
