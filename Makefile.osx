# Makefile.osx - macOS-specific build logic for CoolBox

# Set Python executable (prefer venv)
PYTHON := $(if $(wildcard .venv/bin/python),$(CURDIR)/.venv/bin/python,python3)

# Homebrew is the default package manager on macOS
BREW := $(shell command -v brew 2>/dev/null)

# Emscripten SDK location (override with EMSDK=/your/path)
EMSDK ?= $(HOME)/emsdk

# Set global DYLD_LIBRARY_PATH for all run/install commands
DYLD_LIBRARY_PATH := $(CURDIR)/lib:$(DYLD_LIBRARY_PATH)

.DEFAULT_GOAL := help

# Support "make build app NAME" and "make build library NAME [NAME...]"
BUILD_KIND := $(firstword $(filter app library,$(MAKECMDGOALS)))
BUILD_NAMES := $(filter-out build app library,$(MAKECMDGOALS))
PACKAGE_NAMES := $(filter-out package library libraries,$(MAKECMDGOALS))
RUN_NAMES := $(filter-out run app,$(MAKECMDGOALS))

ifneq ($(filter build,$(MAKECMDGOALS)),)
  ifneq ($(strip $(BUILD_KIND)),)
    $(eval $(BUILD_KIND):;@:)
    $(eval $(BUILD_NAMES):;@:)
  endif
endif

ifneq ($(filter package,$(MAKECMDGOALS)),)
  ifneq ($(strip $(PACKAGE_NAMES)),)
    $(eval library:;@:)
    $(eval libraries:;@:)
    $(eval $(PACKAGE_NAMES):;@:)
  endif
endif

ifneq ($(filter run,$(MAKECMDGOALS)),)
  ifneq ($(firstword $(filter app,$(MAKECMDGOALS))),)
    $(eval app:;@:)
    $(eval $(RUN_NAMES):;@:)
  endif
endif

.PHONY: help configure build build_libraries build_apps package run list list_apps list_libraries apps libraries test install_system_deps clean run_python_bindings_battery_demo run_python_bindings_battery_graphics_demo run_python_bindings_battery_graphics_split_demo

help:
	@echo "\nCoolBox macOS Build System"
	@echo "----------------------------------------"
	@echo "make configure            Configure CMake for macOS (Unix Makefiles)"
	@echo "make build                Build all targets"
	@echo "make build app NAME       Build one app from _deliverables/apps"
	@echo "make build library NAME   Build a library group or individual libraries"
	@echo "make build_libraries      Build all libraries"
	@echo "make build_apps           Build all apps"
	@echo "make build_NAME           Build a specific CMake target"
	@echo "make package library NAME Build and copy libraries into lib/packages/"
	@echo "make run app NAME          Run a built app (builds first if missing)"
	@echo "make run app NAME TARGET   Run a specific executable for multi-target apps"
	@echo "make run app NAME RUN_ARGS=\"...\"  Pass runtime arguments to the app"
	@echo "make list_apps            List apps in _deliverables/apps"
	@echo "make list_libraries       List libraries in _deliverables/libraries"
	@echo "make list apps            Alias for make list_apps"
	@echo "make list libraries       Alias for make list_libraries"
	@echo "make run_python_bindings_battery_demo                 Run battery simulator CSV demo"
	@echo "make run_python_bindings_battery_graphics_demo        Run battery simulator + combined graphics demo"
	@echo "make run_python_bindings_battery_graphics_split_demo  Run battery simulator + split graphics demo"
	@echo "make test                 Run all tests"
	@echo "make install_system_deps  Install system dependencies via Homebrew"
	@echo "make clean                Remove build artifacts"

configure:
	@echo "[Makefile.osx] Configuring CMake for macOS..."
	@cmake -S . -B build -G "Unix Makefiles"

build: configure
	@if [ -n "$(strip $(BUILD_KIND))" ]; then \
		echo "[Makefile.osx] Building deliverable $(BUILD_KIND): $(BUILD_NAMES)"; \
		if [ "$(BUILD_KIND)" = "app" ]; then \
			echo "[Makefile.osx] Ensuring BUILD_BINARIES=ON for app targets..."; \
			cmake -S . -B build -G "Unix Makefiles" -DBUILD_BINARIES=ON; \
		fi; \
		$(PYTHON) _scripts/build_scripts/build_deliverable.py $(BUILD_KIND) $(BUILD_NAMES); \
	else \
		echo "[Makefile.osx] Building all targets..."; \
		cmake --build build; \
	fi

package: configure
	@if [ -z "$(strip $(PACKAGE_NAMES))" ]; then \
		echo "Usage: make package library NAME [NAME...]"; \
		exit 1; \
	fi
	@echo "[Makefile.osx] Packaging libraries: $(PACKAGE_NAMES)"
	@$(PYTHON) _scripts/package_libraries.py $(PACKAGE_NAMES)

run:
	@if [ -z "$(strip $(RUN_NAMES))" ]; then \
		echo "Usage: make run app NAME [TARGET] [RUN_ARGS=\"...\"]"; \
		echo "   or: make -- run app NAME [TARGET] --flag [args]"; \
		exit 1; \
	fi
	@echo "[Makefile.osx] Running app: $(RUN_NAMES) $(RUN_ARGS)"
	@$(PYTHON) _scripts/run_deliverable.py $(RUN_NAMES) $(RUN_ARGS)

build_libraries: configure
	@echo "[Makefile.osx] Building all libraries..."
	@cmake --build build

build_apps: configure
	@echo "[Makefile.osx] Building all apps..."
	@cmake --build build

build_%: configure
	@echo "[Makefile.osx] Building target: $*"
	@cmake --build build --target $*

list:
	@if [ "$(words $(MAKECMDGOALS))" = "1" ]; then \
		echo "Use 'make list_apps' or 'make list_libraries'."; \
	fi

list_apps:
	@$(PYTHON) _scripts/list_deliverables.py apps

list_libraries:
	@$(PYTHON) _scripts/list_deliverables.py libraries

apps: list_apps

libraries: list_libraries

# Run all tests

test: configure
	@echo "[Makefile.osx] Building test binaries..."
	@cmake --build build
	@echo "[Makefile.osx] Running all tests..."
	@cd build && ctest --output-on-failure || true

# Install system dependencies using Homebrew
install_system_deps:
	@if [ -z "$(BREW)" ]; then \
		echo "Homebrew not found. Please install Homebrew: https://brew.sh/"; \
		exit 1; \
	fi
	@echo "[Makefile.osx] Installing system dependencies via Homebrew..."
	@$(BREW) install cmake doxygen gsl eigen || true

clean:
	@echo "[Makefile.osx] Cleaning build artifacts..."
	@rm -rf build lib

run_python_bindings_battery_demo:
	@echo "[Makefile.osx] Running python bindings battery simulator demo..."
	@cd _deliverables/libraries/bindings/python_bindings && $(PYTHON) examples/battery_simulator_demo.py

run_python_bindings_battery_graphics_demo:
	@echo "[Makefile.osx] Running python bindings battery simulator graphics demo..."
	@cd _deliverables/libraries/bindings/python_bindings && $(PYTHON) examples/battery_simulator_graphics_demo.py

run_python_bindings_battery_graphics_split_demo:
	@echo "[Makefile.osx] Running python bindings battery simulator split graphics demo..."
	@cd _deliverables/libraries/bindings/python_bindings && $(PYTHON) examples/battery_simulator_graphics_split_demo.py
