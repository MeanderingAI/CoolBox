#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) buffer LeftBuffer {
    uint16_t values[];
} left_buffer;

layout(set = 0, binding = 1, std430) readonly buffer RightBuffer {
    uint16_t values[];
} right_buffer;

layout(set = 0, binding = 2, std430) buffer AuxiliaryBuffer {
    uint16_t values[];
} auxiliary_buffer;

layout(set = 0, binding = 3, std430) buffer OutputBuffer {
    uint16_t values[];
} output_buffer;

layout(push_constant) uniform Parameters {
    uint operation;
    uint count;
    uint rows;
    uint columns;
    uint inner;
    uint scalar_low;
    uint scalar_high;
    uint encoding;
    uint extra0;
    uint extra1;
    uint extra2;
    uint extra3;
} parameters;

float decode_value(uint16_t encoded) {
    if (parameters.encoding == 3) {
        return unpackHalf2x16(uint(encoded)).x;
    }
    return uintBitsToFloat(uint(encoded) << 16);
}

uint16_t encode_value(float value) {
    if (parameters.encoding == 3) {
        return uint16_t(packHalf2x16(vec2(value, 0.0)) & 0xffffu);
    }
    uint bits = floatBitsToUint(value);
    uint rounding_bias = 0x7fffu + ((bits >> 16) & 1u);
    return uint16_t((bits + rounding_bias) >> 16);
}

shared float left_tile[256];
shared float right_tile[256];

void main() {
    if (parameters.operation == 6 ||
        parameters.operation == 8 ||
        parameters.operation == 27 ||
        parameters.operation == 28) {
        uint local_index = gl_LocalInvocationID.x;
        uint local_row = local_index / 16;
        uint local_column = local_index % 16;
        uint row = gl_WorkGroupID.y * 16 + local_row;
        uint column = gl_WorkGroupID.x * 16 + local_column;
        float total =
            parameters.operation == 8 &&
            column < parameters.columns
                ? decode_value(auxiliary_buffer.values[column])
                : 0.0;
        for (uint tile = 0; tile < parameters.inner; tile += 16) {
            uint left_column = tile + local_column;
            uint right_row = tile + local_row;
            left_tile[local_index] =
                row < parameters.rows &&
                left_column < parameters.inner
                    ? decode_value(
                        parameters.operation == 28
                            ? left_buffer.values[
                                left_column * parameters.rows + row]
                            : left_buffer.values[
                                row * parameters.inner + left_column])
                    : 0.0;
            right_tile[local_index] =
                right_row < parameters.inner &&
                column < parameters.columns
                    ? decode_value(
                        parameters.operation == 27
                            ? right_buffer.values[
                                column * parameters.inner + right_row]
                            : right_buffer.values[
                                right_row * parameters.columns + column])
                    : 0.0;
            barrier();
            for (uint offset = 0; offset < 16; ++offset) {
                total +=
                    left_tile[local_row * 16 + offset] *
                    right_tile[offset * 16 + local_column];
            }
            barrier();
        }
        if (row < parameters.rows &&
            column < parameters.columns) {
            output_buffer.values[
                row * parameters.columns + column] =
                encode_value(total);
        }
        return;
    }

    uint index = gl_GlobalInvocationID.x;
    if (parameters.operation == 22 ||
        parameters.operation == 33) {
        uint local_index = gl_LocalInvocationID.x;
        float value = index < parameters.count
            ? decode_value(left_buffer.values[index])
            : 0.0;
        left_tile[local_index] =
            parameters.operation == 22 ? value * value : value;
        barrier();
        for (uint stride = 128; stride > 0; stride >>= 1) {
            if (local_index < stride) {
                left_tile[local_index] +=
                    left_tile[local_index + stride];
            }
            barrier();
        }
        if (local_index == 0) {
            output_buffer.values[gl_WorkGroupID.x] =
                encode_value(left_tile[0]);
        }
        return;
    }
    if (index >= parameters.count) {
        return;
    }
    float left = decode_value(left_buffer.values[index]);
    float scalar = uintBitsToFloat(parameters.scalar_low);
    if (parameters.operation == 0) {
        output_buffer.values[index] = encode_value(
            left + decode_value(right_buffer.values[index]));
    } else if (parameters.operation == 1) {
        output_buffer.values[index] = encode_value(
            left - decode_value(right_buffer.values[index]));
    } else if (parameters.operation == 2) {
        output_buffer.values[index] = encode_value(
            left * decode_value(right_buffer.values[index]));
    } else if (parameters.operation == 3) {
        output_buffer.values[index] = encode_value(
            left / decode_value(right_buffer.values[index]));
    } else if (parameters.operation == 4) {
        output_buffer.values[index] = encode_value(left * scalar);
    } else if (parameters.operation == 5) {
        output_buffer.values[index] = encode_value(left / scalar);
    } else if (parameters.operation == 7) {
        uint row = index / parameters.columns;
        uint column = index % parameters.columns;
        output_buffer.values[column * parameters.rows + row] =
            left_buffer.values[index];
    } else if (parameters.operation == 9) {
        output_buffer.values[index] = encode_value(max(left, 0.0));
    } else if (parameters.operation == 10) {
        output_buffer.values[index] = encode_value(
            left > 0.0 ? decode_value(right_buffer.values[index]) : 0.0);
    } else if (parameters.operation == 11) {
        if (index >= parameters.rows) return;
        uint base = index * parameters.columns;
        float maximum = -1.0 / 0.0;
        for (uint column = 0; column < parameters.columns; ++column)
            maximum = max(maximum,
                decode_value(left_buffer.values[base + column]));
        float total = 0.0;
        for (uint column = 0; column < parameters.columns; ++column)
            total += exp(decode_value(
                left_buffer.values[base + column]) - maximum);
        for (uint column = 0; column < parameters.columns; ++column)
            output_buffer.values[base + column] = encode_value(
                exp(decode_value(left_buffer.values[base + column]) -
                    maximum) / total);
    } else if (parameters.operation == 12) {
        output_buffer.values[index] = encode_value(
            decode_value(right_buffer.values[index]) == 0.0
                ? -1e9 : left);
    } else if (parameters.operation == 13 ||
               parameters.operation == 14 ||
               parameters.operation == 15) {
        if (parameters.operation != 15 && index >= parameters.rows) return;
        if (parameters.operation == 15 && index >= parameters.columns) return;
        if (parameters.operation == 15) {
            float parameter_gradient = 0.0;
            for (uint row = 0; row < parameters.rows; ++row) {
                uint base = row * parameters.columns;
                float mean = 0.0;
                for (uint column = 0; column < parameters.columns; ++column)
                    mean += decode_value(
                        left_buffer.values[base + column]);
                mean /= float(parameters.columns);
                float variance = 0.0;
                for (uint column = 0; column < parameters.columns; ++column) {
                    float difference = decode_value(
                        left_buffer.values[base + column]) - mean;
                    variance += difference * difference;
                }
                variance /= float(parameters.columns);
                float normalized = (decode_value(
                    left_buffer.values[base + index]) - mean) *
                    inversesqrt(variance + scalar);
                parameter_gradient += decode_value(
                    right_buffer.values[base + index]) * normalized;
            }
            output_buffer.values[index] =
                encode_value(parameter_gradient);
            return;
        }
        uint base = index * parameters.columns;
        float mean = 0.0;
        for (uint column = 0; column < parameters.columns; ++column)
            mean += decode_value(left_buffer.values[base + column]);
        mean /= float(parameters.columns);
        float variance = 0.0;
        for (uint column = 0; column < parameters.columns; ++column) {
            float difference =
                decode_value(left_buffer.values[base + column]) - mean;
            variance += difference * difference;
        }
        variance /= float(parameters.columns);
        float inverse = inversesqrt(variance + scalar);
        if (parameters.operation == 13) {
            for (uint column = 0; column < parameters.columns; ++column) {
                float normalized = (decode_value(
                    left_buffer.values[base + column]) - mean) * inverse;
                output_buffer.values[base + column] = encode_value(
                    normalized * decode_value(
                        right_buffer.values[column]) +
                    decode_value(auxiliary_buffer.values[column]));
            }
        } else {
            float sum_dy = 0.0;
            float sum_dy_normalized = 0.0;
            for (uint column = 0; column < parameters.columns; ++column) {
                float normalized = (decode_value(
                    left_buffer.values[base + column]) - mean) * inverse;
                float dy = decode_value(
                    right_buffer.values[base + column]) *
                    decode_value(auxiliary_buffer.values[column]);
                sum_dy += dy;
                sum_dy_normalized += dy * normalized;
            }
            float width = float(parameters.columns);
            for (uint column = 0; column < parameters.columns; ++column) {
                float normalized = (decode_value(
                    left_buffer.values[base + column]) - mean) * inverse;
                float dy = decode_value(
                    right_buffer.values[base + column]) *
                    decode_value(auxiliary_buffer.values[column]);
                output_buffer.values[base + column] = encode_value(
                    inverse / width * (width * dy - sum_dy -
                    normalized * sum_dy_normalized));
            }
        }
    } else if (parameters.operation == 16) {
        if (index >= parameters.columns) return;
        float total = 0.0;
        for (uint row = 0; row < parameters.rows; ++row)
            total += decode_value(left_buffer.values[
                row * parameters.columns + index]);
        output_buffer.values[index] = encode_value(total);
    } else if (parameters.operation == 17) {
        output_buffer.values[index] = encode_value(left + decode_value(
            right_buffer.values[index % parameters.columns]));
    } else if (parameters.operation == 18) {
        output_buffer.values[index] = encode_value(left * decode_value(
            right_buffer.values[index % parameters.columns]));
    } else if (parameters.operation == 19) {
        output_buffer.values[index] = encode_value(
            left + decode_value(right_buffer.values[index]));
    } else if (parameters.operation == 20) {
        uint row = index / parameters.columns;
        uint column = index % parameters.columns;
        uint offset = uint(scalar);
        output_buffer.values[index] = left_buffer.values[
            row * parameters.inner + offset + column];
    } else if (parameters.operation == 21) {
        uint width = parameters.columns + parameters.inner;
        uint row = index / width;
        uint column = index % width;
        output_buffer.values[index] = column < parameters.columns
            ? left_buffer.values[row * parameters.columns + column]
            : right_buffer.values[
                row * parameters.inner + column - parameters.columns];
    } else if (parameters.operation == 23) {
        float beta1_correction = uintBitsToFloat(parameters.rows);
        float beta2_correction = uintBitsToFloat(parameters.columns);
        float epsilon = uintBitsToFloat(parameters.inner);
        float update =
            (decode_value(right_buffer.values[index]) / beta1_correction) /
            (sqrt(decode_value(auxiliary_buffer.values[index]) /
                  beta2_correction) + epsilon);
        output_buffer.values[index] = encode_value(
            left - scalar * update);
    } else if (parameters.operation == 24) {
        uint input_base = index * parameters.columns;
        uint output_base =
            index * (parameters.columns + 1);
        float maximum = -1.0 / 0.0;
        for (uint column = 0;
             column < parameters.columns;
             ++column) {
            maximum = max(
                maximum,
                decode_value(left_buffer.values[
                    input_base + column]));
        }
        float denominator = 0.0;
        for (uint column = 0;
             column < parameters.columns;
             ++column) {
            denominator += exp(
                decode_value(left_buffer.values[
                    input_base + column]) - maximum);
        }
        float target_probability = 0.0;
        for (uint column = 0;
             column < parameters.columns;
             ++column) {
            float probability = exp(
                decode_value(left_buffer.values[
                    input_base + column]) - maximum) /
                denominator;
            float target = decode_value(
                right_buffer.values[input_base + column]);
            output_buffer.values[output_base + column] =
                encode_value(
                    (probability - target) /
                    float(parameters.rows));
            target_probability += probability * target;
        }
        output_buffer.values[
            output_base + parameters.columns] =
            encode_value(
                -log(max(target_probability, 1e-30)));
    } else if (parameters.operation == 25) {
        float beta1 = uintBitsToFloat(parameters.rows);
        float beta2 = uintBitsToFloat(parameters.columns);
        float epsilon = uintBitsToFloat(parameters.inner);
        float beta1_correction =
            uintBitsToFloat(parameters.extra0);
        float beta2_correction =
            uintBitsToFloat(parameters.extra1);
        float weight_decay = uintBitsToFloat(parameters.extra2);
        float gradient =
            decode_value(right_buffer.values[index]) *
            uintBitsToFloat(parameters.extra3);
        float first =
            beta1 * decode_value(
                auxiliary_buffer.values[index]) +
            (1.0 - beta1) * gradient;
        float second =
            beta2 * decode_value(
                output_buffer.values[index]) +
            (1.0 - beta2) * gradient * gradient;
        auxiliary_buffer.values[index] = encode_value(first);
        output_buffer.values[index] = encode_value(second);
        float updated =
            decode_value(left_buffer.values[index]) -
            scalar * (first / beta1_correction) /
                (sqrt(second / beta2_correction) + epsilon);
        left_buffer.values[index] = encode_value(
            updated - scalar * weight_decay * updated);
    } else if (parameters.operation == 26) {
        if (decode_value(auxiliary_buffer.values[index]) == 0.0) {
            output_buffer.values[index] = encode_value(-1e9);
            return;
        }
        uint query = index / parameters.columns;
        uint key = index % parameters.columns;
        float total = 0.0;
        for (uint column = 0;
             column < parameters.inner;
             ++column) {
            total += decode_value(left_buffer.values[
                query * parameters.inner + column]) *
                decode_value(right_buffer.values[
                    key * parameters.inner + column]);
        }
        output_buffer.values[index] =
            encode_value(total / scalar);
    } else if (parameters.operation == 29) {
        uint sequence = parameters.rows;
        uint model = parameters.columns;
        uint head_width = model / parameters.inner;
        uint head = index / (sequence * sequence);
        uint within_head = index % (sequence * sequence);
        uint query = within_head / sequence;
        uint key = within_head % sequence;
        if (decode_value(auxiliary_buffer.values[
                query * sequence + key]) == 0.0) {
            output_buffer.values[index] = encode_value(-1e9);
            return;
        }
        float total = 0.0;
        for (uint column = 0; column < head_width; ++column) {
            uint model_column = head * head_width + column;
            total += decode_value(left_buffer.values[
                query * model + model_column]) *
                decode_value(right_buffer.values[
                    key * model + model_column]);
        }
        output_buffer.values[index] =
            encode_value(total / scalar);
    } else if (parameters.operation == 30 ||
               parameters.operation == 31) {
        uint sequence = parameters.rows;
        uint model = parameters.columns;
        uint head_width = model / parameters.inner;
        uint row = index / model;
        uint column = index % model;
        uint head = column / head_width;
        float total = 0.0;
        for (uint other = 0; other < sequence; ++other) {
            uint weight_index = parameters.operation == 30
                ? (head * sequence + row) * sequence + other
                : (head * sequence + other) * sequence + row;
            total += decode_value(left_buffer.values[weight_index]) *
                decode_value(right_buffer.values[
                    other * model + column]);
        }
        output_buffer.values[index] = encode_value(total);
    } else if (parameters.operation == 32) {
        uint sequence = parameters.rows;
        uint model = parameters.columns;
        uint head_width = model / parameters.inner;
        uint head = index / (sequence * sequence);
        uint within_head = index % (sequence * sequence);
        uint query = within_head / sequence;
        uint key = within_head % sequence;
        float total = 0.0;
        for (uint column = 0; column < head_width; ++column) {
            uint model_column = head * head_width + column;
            total += decode_value(left_buffer.values[
                query * model + model_column]) *
                decode_value(right_buffer.values[
                    key * model + model_column]);
        }
        output_buffer.values[index] = encode_value(total);
    } else if (parameters.operation == 34 ||
               parameters.operation == 35) {
        float cubic = 0.7978845608028654 *
            (left + 0.044715 * left * left * left);
        float tangent = tanh(cubic);
        float result;
        if (parameters.operation == 34) {
            result = 0.5 * left * (1.0 + tangent);
        } else {
            float derivative =
                0.5 * (1.0 + tangent) +
                0.5 * left * (1.0 - tangent * tangent) *
                0.7978845608028654 *
                (1.0 + 0.134145 * left * left);
            result = decode_value(right_buffer.values[index]) *
                derivative;
        }
        output_buffer.values[index] = encode_value(result);
    } else if (parameters.operation == 36 ||
               parameters.operation == 37) {
        float sigmoid = 1.0 / (1.0 + exp(-left));
        float result = parameters.operation == 36
            ? left * sigmoid
            : decode_value(right_buffer.values[index]) * sigmoid *
                (1.0 + left * (1.0 - sigmoid));
        output_buffer.values[index] = encode_value(result);
    } else if (parameters.operation == 38 ||
               parameters.operation == 39) {
        uint row = index / parameters.columns;
        uint column = index % parameters.columns;
        uint head_width =
            parameters.columns / uint(scalar + 0.5);
        uint pair = (column % head_width) & ~1u;
        float angle = float(row) /
            pow(10000.0, float(pair) / float(head_width));
        if (parameters.operation == 39) angle = -angle;
        uint pair_column = column - (column & 1u);
        uint base = row * parameters.columns + pair_column;
        float even = decode_value(left_buffer.values[base]);
        float odd = decode_value(left_buffer.values[base + 1]);
        output_buffer.values[index] = encode_value(
            (column & 1u) == 0u
                ? even * cos(angle) - odd * sin(angle)
                : even * sin(angle) + odd * cos(angle));
    }
}
