@title2: Sandbox: Generate and Save a Plot

@title2: Example: Linear Regression
@code: python | python_bindings
from coolbox import LinearRegression
import numpy as np

# Generate synthetic data
X = np.array([[1], [2], [3], [4], [5]])
y = np.array([2, 4, 6, 8, 10])

# Fit model
model = LinearRegression()
model.fit(X, y)

# Predict
pred = model.predict(np.array([[6], [7]]))
print("Predictions:", pred)
@endcode

@title2: Example: Decision Tree Classifier
@code: python | python_bindings
from coolbox import DecisionTreeClassifier
import numpy as np

X = np.array([[0, 0], [1, 1], [0, 1], [1, 0]])
y = np.array([0, 1, 1, 0])

clf = DecisionTreeClassifier()
clf.fit(X, y)
print("Prediction for [1, 1]:", clf.predict(np.array([[1, 1]])))
@endcode
