if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED SYMBOL)
    message(FATAL_ERROR "INPUT, OUTPUT, and SYMBOL are required")
endif()

file(READ "${INPUT}" binary_hex HEX)
string(LENGTH "${binary_hex}" binary_hex_length)
file(WRITE "${OUTPUT}" "#pragma once\n#include <cstddef>\n\n")
file(APPEND "${OUTPUT}" "alignas(4) static const unsigned char ${SYMBOL}[] = {\n")

if(binary_hex_length GREATER 0)
    math(EXPR last_offset "${binary_hex_length} - 2")
    set(column 0)
    foreach(offset RANGE 0 ${last_offset} 2)
        string(SUBSTRING "${binary_hex}" ${offset} 2 byte)
        file(APPEND "${OUTPUT}" "0x${byte},")
        math(EXPR column "${column} + 1")
        if(column EQUAL 16)
            file(APPEND "${OUTPUT}" "\n")
            set(column 0)
        endif()
    endforeach()
endif()

file(APPEND "${OUTPUT}" "\n};\n")
file(APPEND "${OUTPUT}" "static const std::size_t ${SYMBOL}_size = sizeof(${SYMBOL});\n")
